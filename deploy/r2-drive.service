[Unit]
Description=R2 Drive VPS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/r2-drive
Environment=R2_DRIVE_DATA=/opt/r2-drive/data
Environment=R2_DRIVE_SITE_NAME=R2 Drive
Environment=R2_DRIVE_HOST=127.0.0.1
Environment=R2_DRIVE_PORT=8090
ExecStart=/usr/bin/python3 /opt/r2-drive/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
